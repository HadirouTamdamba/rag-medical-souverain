# Copy to .env and adjust. Never commit .env.
# Generate a strong key with: make secret

# --- Identity and runtime ----------------------------------------------------
APP_NAME=MediBot RAG
# local | test | production. In `production`, startup fails if API_KEY is
# missing or weak, or if ALLOWED_ORIGINS is '*'; /docs is disabled.
ENVIRONMENT=local
LOG_LEVEL=INFO
# JSON logs, ready for Loki/ELK. Set to false for readable local output.
LOG_JSON=true

# --- Security ----------------------------------------------------------------
# Protects /query, /query/stream, /upload, /ingest/demo and /documents.
# The frontend reads it server-side only, so it never reaches the browser.
# At least 32 characters in production.
API_KEY=

# Origins allowed to call the API directly. With the Next relay in place the
# browser only makes same-origin requests, so this list matters only for
# third-party clients (scripts, integrations).
ALLOWED_ORIGINS=http://localhost:3000

# Enable only behind a trusted reverse proxy: otherwise X-Forwarded-For is
# forgeable and defeats rate limiting.
TRUST_PROXY_HEADERS=false

# --- Capacity ----------------------------------------------------------------
# Each worker loads its own copy of the embedding model (~500 MB).
API_WORKERS=1
# Concurrent LLM generations. Beyond this, on CPU, all of them slow down.
LLM_MAX_CONCURRENCY=2
# Torch threads per process: letting torch grab every core creates contention
# as soon as there is more than one worker.
EMBEDDING_THREADS=2

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_S=60
METRICS_ENABLED=true

FRONTEND_PORT=3000
BACKEND_MEMORY_LIMIT=4g
OLLAMA_MEMORY_LIMIT=12g
QDRANT_MEMORY_LIMIT=2g
FRONTEND_MEMORY_LIMIT=1g

# --- Vector store ------------------------------------------------------------
QDRANT_COLLECTION=medical_docs
# For a managed Qdrant: set QDRANT_URL (https) and QDRANT_API_KEY, which then
# take precedence over QDRANT_HOST/QDRANT_PORT.
# QDRANT_URL=
# QDRANT_API_KEY=

# --- LLM ---------------------------------------------------------------------
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT_S=120
# On CPU, reloading the model costs several minutes: keep this high.
OLLAMA_KEEP_ALIVE=60m
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
# Must cover system prompt + RAG context + history + answer. Below that, Ollama
# silently truncates the BEGINNING of the prompt and the instructions are lost.
LLM_NUM_CTX=4096

# Language the assistant answers in. The default targets French hospitals;
# set it to English (and update LLM_NO_CONTEXT_ANSWER to match) for other users.
LLM_RESPONSE_LANGUAGE=French
LLM_NO_CONTEXT_ANSWER=Je ne dispose pas de cette information dans ma base de connaissances.

# macOS: Docker has no access to the Metal GPU. Uncomment to target a native
# Ollama instance (see README, "Performance on macOS").
# OLLAMA_HOST=http://host.docker.internal:11435

# --- RAG ---------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5
MIN_RELEVANCE_SCORE=0.35
MAX_CONTEXT_CHARS=12000
MAX_HISTORY_MESSAGES=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=25
